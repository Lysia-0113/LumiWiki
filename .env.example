PORT=3000
QA_ADMIN_TOKEN=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 模型支持图片时改为 true；观察、导航和主动截图会发送遮挡后的图片。
LLM_VISION=false
LLM_CONTEXT_WINDOW=64000
LLM_MAX_TOKENS=4096
# 下列三种模型独立选择；BASE_URL / API_KEY 留空时复用 LLM 的对应值。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QA_JUDGE_BASE_URL=
QA_JUDGE_API_KEY=
QA_JUDGE_MODEL=
QA_MATCH_HIGH=0.82
QA_MATCH_MEDIUM=0.62
QA_MATCH_MARGIN=0.05
# 低相似度回落模型，例如你选择的 DeepSeek 模型。
PUBLIC_LLM_BASE_URL=
PUBLIC_LLM_API_KEY=
PUBLIC_LLM_MODEL=
# 公共问答默认跟随主模型视觉设置；需要单独关闭时取消注释。
# PUBLIC_LLM_VISION=false
# 新建项目和旧项目首次迁移的默认值；之后在管理台按项目修改。
PUBLIC_BROWSER_ENABLED=true
PUBLIC_TEST_USERNAME=demo
PUBLIC_TEST_PASSWORD=123456
# Gymbook 联调脚本地址。公共问答跟随项目目标网页，不使用此项校验。
PUBLIC_TEST_URL=http://127.0.0.1:9098
PUBLIC_MAX_TOOL_CALLS=20
TARGET_REPO=/Users/wych/GolandProjects/gymbook
TARGET_URL=http://127.0.0.1:9098
BROWSER_HEADLESS=false
DEEPWIKI_BASE_URL=http://127.0.0.1:8001
DEEPWIKI_REPO=/Users/wych/GolandProjects/deepwiki-open
DEEPWIKI_PROVIDER=openai
DEEPWIKI_MODEL=
WIKI_FULL_INJECT_MAX_CHARS=30000
MAX_TOOL_CALLS=30
# 每个独立章节的工具预算和单次输出预算，不是整本指南的累计限制。
QUICK_START_MAX_TOOL_CALLS=200
QUICK_START_MAX_TOKENS=8192
GUIDE_PLAN_MAX_TOOL_CALLS=100
GUIDE_CHAPTER_TIMEOUT_SECONDS=1800
RUN_TIMEOUT_SECONDS=180
