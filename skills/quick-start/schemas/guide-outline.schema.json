{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "audience", "overview", "chapters"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "overview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "glossary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "meaning"],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 80
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "scope", "questions"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 40
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "minItems": 1,
            "maxItems": 40
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "maxItems": 40
          },
          "entryUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "maxItems": 20
          },
          "wikiPageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "maxItems": 40
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "maxItems": 63
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
